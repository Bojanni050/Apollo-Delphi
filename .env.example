# Apollo configuration
# Copy to backend/.env (or export) before running.

# --- Core ---
ENVIRONMENT=development

# --- Database (PostgreSQL + pgvector is the primary source of truth) ---
# Local docker-compose default:
APOLLO_DATABASE_URL=postgresql+psycopg2://apollo:apollo@localhost:5432/apollo
# SQLite fallback for quick offline development (tests use this):
# APOLLO_DATABASE_URL=sqlite:///./apollo.db

# --- LLM abstraction (provider-independent, two tiers) ---
# Provider per tier: mock (offline, deterministic) | openai (any OpenAI-compatible endpoint:
# OpenAI, Ollama, LM Studio, vLLM, OpenRouter, EdenAI, Gemini's OpenAI endpoint, ...) | anthropic
# All of this can also be set in the app (Instellingen); values chosen there win.
#
# Main tier: reasoning (issue investigation, document generation).
LLM_PROVIDER=mock
LLM_MODEL=mock-model
# openai: empty = api.openai.com; for a local runtime e.g. http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
LLM_API_KEY=
#
# Background tier: bulk work (claim extraction, Delphi Pulse). Every field left empty follows
# the main tier. The main key is never sent to a different background endpoint.
# Example: main on EdenAI, background on Gemini:
#   BACKGROUND_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   BACKGROUND_LLM_MODEL=models/gemini-3.8-flash
#   BACKGROUND_LLM_API_KEY=...
BACKGROUND_LLM_PROVIDER=
BACKGROUND_LLM_BASE_URL=
BACKGROUND_LLM_MODEL=
BACKGROUND_LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# --- Embeddings (semantic search) ---
# mock   = deterministic hash vectors, not semantic (tests / offline)
# openai = any OpenAI-compatible /embeddings endpoint: OpenAI, a local Ollama or llama-server,
#          Jina, Gemini's OpenAI endpoint, vLLM, ...
# Also configurable in the app (Instellingen); values chosen there win. Every stored vector records
# its model and dimension, and search only compares vectors of the active model: after changing
# the model, re-index (Instellingen > Embeddingmodel, or POST /api/embeddings/reindex).
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedder
# Only for the mock provider; real models report their own dimension.
EMBEDDING_DIMENSIONS=64
# Empty = api.openai.com. Local: http://localhost:11434/v1 (Ollama) or http://localhost:8080/v1 (llama-server)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
# Which local runtime downloads models for you: ollama | llamacpp
EMBEDDING_RUNTIME=ollama
# Where llama.cpp GGUF files are stored (default ./models)
LLAMACPP_MODELS_DIR=

# --- Secrets: never hard-code; export or use your shell profile ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub personal access token (optional): raises API rate limits and enables
# private repository ingestion. Uses APOLLO_GITHUB_TOKEN so the app never
# accidentally picks up a generic GITHUB_TOKEN from your environment.
APOLLO_GITHUB_TOKEN=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md

# --- Chunking / search tuning ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
SEARCH_TOP_K=8
