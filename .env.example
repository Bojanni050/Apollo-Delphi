# Apollo configuration
# Copy to backend/.env (or export) before running.

# --- Core ---
ENVIRONMENT=development

# --- Database (PostgreSQL + pgvector is the primary source of truth) ---
# Local docker-compose default:
APOLLO_DATABASE_URL=postgresql+psycopg2://apollo:apollo@localhost:5432/apollo
# SQLite fallback for quick offline development (tests use this):
# APOLLO_DATABASE_URL=sqlite:///./apollo.db

# --- LLM abstraction (provider-independent) ---
# mock  = deterministic offline providers (no external calls, full pipeline works)
# openai = any OpenAI-compatible chat-completions endpoint
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_BASE_URL=https://api.openai.com/v1

# --- Embedding abstraction ---
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedder
EMBEDDING_DIMENSIONS=64
EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- Secrets: never hard-code; export or use your shell profile ---
OPENAI_API_KEY=

# GitHub personal access token (optional): raises API rate limits and enables
# private repository ingestion. Uses APOLLO_GITHUB_TOKEN so the app never
# accidentally picks up a generic GITHUB_TOKEN from your environment.
APOLLO_GITHUB_TOKEN=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md

# --- Chunking / search tuning ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
SEARCH_TOP_K=8
